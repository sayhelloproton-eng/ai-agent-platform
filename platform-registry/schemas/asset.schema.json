{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Platform Asset",
  "type": "object",
  "required": [
    "asset_id",
    "asset_type",
    "status",
    "evidence_level",
    "materialized",
    "current_path",
    "target_path",
    "canonical_path",
    "publication_status",
    "migration_state"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "asset_type": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "idea",
        "candidate",
        "designing",
        "approved",
        "partial",
        "implemented",
        "verified",
        "deprecated",
        "superseded",
        "archived",
        "accepted",
        "adopted",
        "proposed",
        "validated"
      ]
    },
    "evidence_level": {
      "enum": [
        "hypothesis",
        "observed",
        "decided",
        "verified"
      ]
    },
    "materialized": {
      "type": "boolean"
    },
    "current_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonical_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "publication_status": {
      "enum": [
        "unpublished",
        "published"
      ]
    },
    "migration_state": {
      "enum": [
        "planned",
        "in_progress",
        "complete",
        "blocked"
      ]
    },
    "superseded_by": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    }
  }
}
