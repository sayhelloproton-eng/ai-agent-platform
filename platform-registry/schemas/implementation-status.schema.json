{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Implementation Status",
  "type": "object",
  "required": [
    "id",
    "status",
    "implemented_by",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "idea",
        "candidate",
        "designing",
        "partial",
        "implemented",
        "verified",
        "deprecated",
        "superseded",
        "archived"
      ]
    },
    "implemented_by": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
