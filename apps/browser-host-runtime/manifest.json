{
  "manifest_version": 3,
  "name": "AI Agent Platform Browser Host Runtime",
  "version": "0.2.1",
  "description": "Observe, open and drive authorized ChatGPT role sessions with dual-stage dispatch reporting.",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "alarms",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/content/response-lifecycle.js",
        "src/content/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "options_page": "src/options/index.html",
  "action": {
    "default_title": "Open Browser Host Runtime"
  },
  "commands": {
    "emergency-stop": {
      "suggested_key": {
        "default": "Alt+Shift+X",
        "mac": "MacCtrl+Shift+X"
      },
      "description": "Emergency stop Browser Host Runtime"
    }
  }
}
