{
  "name": "@ai-agent-platform/execution-flow-runtime",
  "version": "0.0.0-lab.13.3.1",
  "description": "Spec-driven execution-flow runtime with bounded inference and capability execution.",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "bin": {
    "aap-execution-flow": "./cli.ts"
  },
  "files": [
    "index.ts",
    "cli.ts",
    "src/**/*.ts",
    "spec/**/*.json",
    "docs/**/*.md",
    "examples/**/*.json",
    "CHANGELOG.md",
    "README.md",
    "tests/**/*.ts",
    "live-tests/**/*.ts",
    "fixtures/**/*",
    "tsconfig.json"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "cli": "tsx cli.ts",
    "start": "tsx cli.ts start",
    "stop": "tsx cli.ts stop",
    "restart": "tsx cli.ts restart",
    "status": "tsx cli.ts status",
    "doctor": "tsx cli.ts doctor",
    "docs": "tsx cli.ts docs",
    "describe": "tsx cli.ts describe --json",
    "test:mlxhub-live": "tsx --test live-tests/mlxhub-live.test.ts",
    "test:mlxhub-roles-live": "tsx --test live-tests/mlxhub-role-escalation-live.test.ts",
    "test:mlxhub-production-live": "tsx --test live-tests/mlxhub-production-flow-live.test.ts",
    "deployment:requirements": "tsx cli.ts deployment requirements --json",
    "test:mlxhub-capabilities-live": "tsx --test live-tests/mlxhub-platform-capability-live.test.ts",
    "test:mlxhub-reason-capabilities-live": "tsx --test live-tests/mlxhub-reason-capability-live.test.ts"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "execution-flow",
    "runtime",
    "agent",
    "workflow",
    "inference",
    "capability"
  ]
}
