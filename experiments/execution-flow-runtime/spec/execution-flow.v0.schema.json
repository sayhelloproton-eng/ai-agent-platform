{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-platform.local/spec/execution-flow.v0.schema.json",
  "title": "ExecutionFlowV0",
  "type": "object",
  "required": ["contract", "flow_id", "version", "entry_node", "nodes"],
  "additionalProperties": false,
  "properties": {
    "contract": { "const": "execution.flow.v0" },
    "flow_id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "entry_node": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/actionNode" },
          { "$ref": "inference-node.v0.schema.json" },
          { "$ref": "#/$defs/switchNode" },
          { "$ref": "#/$defs/returnNode" }
        ]
      }
    }
  },
  "$defs": {
    "actionNode": {
      "type": "object",
      "required": ["id", "type", "capability", "arguments", "next"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "action" },
        "capability": { "type": "string", "minLength": 1 },
        "arguments": {
          "$ref": "template-value.v0.schema.json#/$defs/templateObject"
        },
        "next": { "type": "string", "minLength": 1 }
      }
    },
    "switchNode": {
      "type": "object",
      "required": ["id", "type", "select", "cases", "default"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "switch" },
        "select": {
          "$ref": "template-value.v0.schema.json#/$defs/bindingRef"
        },
        "cases": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "default": { "type": "string", "minLength": 1 }
      }
    },
    "returnNode": {
      "type": "object",
      "required": ["id", "type", "output"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "return" },
        "output": {
          "$ref": "template-value.v0.schema.json#/$defs/templateValue"
        }
      }
    }
  }
}
