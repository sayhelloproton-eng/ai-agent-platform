{
  "contract": "execution.run.v0",
  "execution_id": "exec-runtime-health-example",
  "flow": {
    "contract": "execution.flow.v0",
    "flow_id": "runtime-health-production-shaped-check",
    "version": 4,
    "entry_node": "read-status",
    "nodes": [
      {
        "id": "read-status",
        "type": "action",
        "capability": "workspace.file.read",
        "arguments": {
          "path": "fixtures/runtime-status.json"
        },
        "next": "status-route"
      },
      {
        "id": "status-route",
        "type": "switch",
        "select": {
          "$ref": "steps.read-status.output.json.reported_status"
        },
        "cases": {
          "healthy": "verification-required-route",
          "unhealthy": "unhealthy-initial"
        },
        "default": "unhealthy-initial"
      },
      {
        "id": "verification-required-route",
        "type": "switch",
        "select": {
          "$ref": "steps.read-status.output.json.verification_required"
        },
        "cases": {
          "true": "run-node-version",
          "false": "healthy-no-command"
        },
        "default": "unhealthy-initial"
      },
      {
        "id": "run-node-version",
        "type": "action",
        "capability": "process.command.run-fixed",
        "arguments": {
          "command_ref": "node.version"
        },
        "next": "readback-status"
      },
      {
        "id": "readback-status",
        "type": "action",
        "capability": "workspace.file.read",
        "arguments": {
          "path": "fixtures/runtime-status.json"
        },
        "next": "fast-verify"
      },
      {
        "id": "fast-verify",
        "type": "inference",
        "backend": "mlxhub",
        "role": "fast",
        "instruction": "Verify only the supplied evidence. If command.exit_code is 0, command.stdout is a Node version whose major equals readback.expected_node_major, and readback.reported_status is healthy, return state=verified, decision=healthy, and the parsed integer major. If the evidence clearly shows a mismatched major, nonzero exit code, or unhealthy readback, return state=unhealthy and decision=unhealthy. Only when the supplied evidence cannot be interpreted deterministically return state=uncertain, decision=unknown, observed_node_major=null. Return only the declared JSON structure.",
        "input": {
          "initial_status": {
            "$ref": "steps.read-status.output.json"
          },
          "readback": {
            "$ref": "steps.readback-status.output.json"
          },
          "command": {
            "$ref": "steps.run-node-version.output"
          }
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "verified",
                "unhealthy",
                "uncertain"
              ]
            },
            "decision": {
              "enum": [
                "healthy",
                "unhealthy",
                "unknown"
              ]
            },
            "observed_node_major": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "state",
            "decision",
            "observed_node_major"
          ],
          "additionalProperties": false
        },
        "next": "verification-route"
      },
      {
        "id": "verification-route",
        "type": "switch",
        "select": {
          "$ref": "steps.fast-verify.output.state"
        },
        "cases": {
          "verified": "fast-done",
          "unhealthy": "unhealthy-after-command",
          "uncertain": "reason-resolve"
        },
        "default": "reason-resolve"
      },
      {
        "id": "reason-resolve",
        "type": "inference",
        "backend": "mlxhub",
        "role": "reason",
        "instruction": "Independently resolve the supplied escalation context. Treat FAST outputs as assessments, not truth. Use the original request context plus all supplied execution evidence and FAST uncertainty details. If the command successfully reports a Node major equal to readback.expected_node_major and readback.reported_status is healthy, return decision=healthy and resolution=command_matches_expected. If there is a clear mismatch or unhealthy evidence, return decision=unhealthy and resolution=command_mismatch. If the evidence remains insufficient, fail closed with decision=unhealthy and resolution=insufficient_evidence. Return only the declared JSON structure.",
        "input": {
          "escalation_context": {
            "trigger": "fast_verification_uncertain",
            "original_input": {
              "$ref": "inputs.request"
            },
            "objective": "resolve runtime-health verification uncertainty without changing the Flow or executing new capabilities",
            "constraints": {
              "fast_output_is_not_truth": true,
              "use_supplied_evidence_only": true,
              "fail_closed_if_insufficient": true
            },
            "evidence": {
              "initial_status": {
                "$ref": "steps.read-status.output.json"
              },
              "command": {
                "$ref": "steps.run-node-version.output"
              },
              "readback": {
                "$ref": "steps.readback-status.output.json"
              }
            },
            "fast": {
              "verification": {
                "$ref": "steps.fast-verify.output"
              }
            }
          }
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "decision": {
              "enum": [
                "healthy",
                "unhealthy"
              ]
            },
            "resolution": {
              "enum": [
                "command_matches_expected",
                "command_mismatch",
                "insufficient_evidence"
              ]
            }
          },
          "required": [
            "decision",
            "resolution"
          ],
          "additionalProperties": false
        },
        "next": "reason-done"
      },
      {
        "id": "healthy-no-command",
        "type": "return",
        "output": {
          "decision": "healthy",
          "resolved_by": "flow",
          "command_executed": false
        }
      },
      {
        "id": "fast-done",
        "type": "return",
        "output": {
          "decision": {
            "$ref": "steps.fast-verify.output.decision"
          },
          "resolved_by": "fast",
          "command_executed": true,
          "verification": {
            "$ref": "steps.fast-verify.output"
          },
          "command": {
            "$ref": "steps.run-node-version.output"
          },
          "readback": {
            "$ref": "steps.readback-status.output.json"
          }
        }
      },
      {
        "id": "reason-done",
        "type": "return",
        "output": {
          "decision": {
            "$ref": "steps.reason-resolve.output.decision"
          },
          "resolved_by": "reason",
          "command_executed": true,
          "resolution": {
            "$ref": "steps.reason-resolve.output.resolution"
          },
          "command": {
            "$ref": "steps.run-node-version.output"
          },
          "readback": {
            "$ref": "steps.readback-status.output.json"
          }
        }
      },
      {
        "id": "unhealthy-initial",
        "type": "return",
        "output": {
          "decision": "unhealthy",
          "resolved_by": "flow",
          "command_executed": false
        }
      },
      {
        "id": "unhealthy-after-command",
        "type": "return",
        "output": {
          "decision": "unhealthy",
          "resolved_by": "fast",
          "command_executed": true,
          "verification": {
            "$ref": "steps.fast-verify.output"
          },
          "command": {
            "$ref": "steps.run-node-version.output"
          },
          "readback": {
            "$ref": "steps.readback-status.output.json"
          }
        }
      }
    ]
  },
  "inputs": {
    "request": {
      "objective": "verify the configured runtime status and Node major using declared evidence only",
      "expected_runtime": "node20",
      "verification_policy": "fail closed when evidence remains insufficient"
    }
  },
  "authorization": {
    "allowed_capabilities": [
      "workspace.file.read",
      "process.command.run-fixed"
    ]
  },
  "max_node_runs": 12,
  "correlation": {
    "source": "example",
    "gate": "EF-4",
    "external_ref": "opaque-production-shaped-runtime-check"
  }
}
