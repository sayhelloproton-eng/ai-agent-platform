{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-insight-distillation:experience-candidate:1.1",
  "title": "Engineering Experience Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "title",
    "intent",
    "event",
    "assumptions",
    "claims",
    "evidence",
    "analysis",
    "resolution",
    "proposed_lesson",
    "source_references",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.1"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 2,
          "maxLength": 100
        },
        "project": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 2,
          "maxLength": 120
        },
        "milestone": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 2,
          "maxLength": 160
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_outcome"
      ],
      "properties": {
        "expected_outcome": {
          "type": "string",
          "minLength": 8,
          "maxLength": 1000
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_behavior",
        "impact"
      ],
      "properties": {
        "observed_behavior": {
          "type": "string",
          "minLength": 8,
          "maxLength": 3000
        },
        "impact": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1500
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 800
      },
      "uniqueItems": true
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "statement",
          "classification",
          "evidence_refs"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^CLM-[A-Za-z0-9_-]{1,40}$"
          },
          "statement": {
            "type": "string",
            "minLength": 5,
            "maxLength": 1500
          },
          "classification": {
            "enum": [
              "verified_fact",
              "engineering_inference",
              "open_hypothesis",
              "recommendation"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "uniqueItems": true
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence_item"
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_cause",
        "root_cause_confidence",
        "contributing_factors",
        "open_questions"
      ],
      "properties": {
        "root_cause": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 5,
          "maxLength": 2000
        },
        "root_cause_confidence": {
          "enum": [
            "unknown",
            "low",
            "medium",
            "high"
          ]
        },
        "contributing_factors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 1000
          },
          "uniqueItems": true
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 1000
          },
          "uniqueItems": true
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "verification"
      ],
      "properties": {
        "action": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 5,
          "maxLength": 3000
        },
        "verification": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 5,
          "maxLength": 3000
        }
      }
    },
    "proposed_lesson": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 5,
      "maxLength": 1200
    },
    "source_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source_reference"
      }
    },
    "status": {
      "enum": [
        "draft",
        "ready_for_distillation",
        "needs_evidence",
        "rejected"
      ]
    },
    "comparison_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "insight_index_available",
        "compared_insight_ids"
      ],
      "properties": {
        "insight_index_available": {
          "type": "boolean"
        },
        "compared_insight_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^EI-[A-Z0-9_-]{3,63}$"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 5,
          "maxLength": 1200
        }
      }
    }
  },
  "$defs": {
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "type",
        "summary",
        "reference",
        "confidence"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^EVD-[A-Za-z0-9_-]{1,40}$"
        },
        "type": {
          "enum": [
            "test",
            "runtime_observation",
            "log",
            "code",
            "commit",
            "document",
            "screenshot",
            "execution_report",
            "human_observation"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1500
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "source_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "type",
        "reference",
        "summary"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^SRC-[A-Za-z0-9_-]{1,40}$"
        },
        "type": {
          "enum": [
            "test",
            "runtime_observation",
            "log",
            "code",
            "commit",
            "document",
            "screenshot",
            "execution_report",
            "human_observation"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "summary": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1500
        }
      }
    }
  }
}
