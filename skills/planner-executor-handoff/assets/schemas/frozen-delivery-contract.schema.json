{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen Artifact Delivery Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "execution_mode",
    "base_commit",
    "branch",
    "knowledge_content_frozen",
    "archive",
    "overlay_paths",
    "delete_paths",
    "validation_commands",
    "commit_message",
    "push_remote",
    "push_branch",
    "stop_on_failure",
    "skill_policy"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "execution_mode": {
      "enum": [
        "apply_frozen_artifacts",
        "continuation"
      ]
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "knowledge_content_frozen": {
      "type": "boolean",
      "const": true
    },
    "archive": {
      "type": "string",
      "minLength": 1
    },
    "overlay_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "delete_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "empty_directories": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "validation_commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "commit_message": {
      "type": "string",
      "minLength": 1
    },
    "push_remote": {
      "type": "string",
      "minLength": 1
    },
    "push_branch": {
      "type": "string",
      "minLength": 1
    },
    "stop_on_failure": {
      "type": "boolean",
      "const": true
    },
    "resume_from": {
      "type": "string",
      "minLength": 1
    },
    "prior_gates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "new_authorization": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "skill_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_knowledge_governance",
        "planner_executor_handoff"
      ],
      "properties": {
        "project_knowledge_governance": {
          "enum": [
            "contract_reference_only",
            "not_required"
          ]
        },
        "planner_executor_handoff": {
          "const": "full"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_mode": {
            "const": "continuation"
          }
        }
      },
      "then": {
        "required": [
          "resume_from",
          "prior_gates",
          "new_authorization"
        ]
      }
    }
  ]
}
