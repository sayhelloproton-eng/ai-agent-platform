{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Knowledge Synthesis Request",
  "type": "object",
  "required": [
    "version",
    "synthesis_id",
    "mode",
    "source_scope",
    "truth_sources",
    "objectives",
    "constraints"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "synthesis_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "directory_consolidation",
        "project_session",
        "asset_formalization"
      ]
    },
    "source_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "truth_sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "object",
      "required": [
        "preserve_stable_ids",
        "write_authority",
        "publication_authority",
        "sensitive_handling"
      ],
      "properties": {
        "preserve_stable_ids": {
          "type": "boolean"
        },
        "write_authority": {
          "enum": [
            "none",
            "proposal_only"
          ]
        },
        "publication_authority": {
          "const": "none"
        },
        "sensitive_handling": {
          "enum": [
            "exclude",
            "redact_and_flag"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
