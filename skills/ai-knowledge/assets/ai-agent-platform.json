{
  "schema_version": "3.0",
  "project": {
    "id": "ai-agent-platform",
    "display_name": "智能体工程探索",
    "canonical_source": "git"
  },
  "canonical_entries": {
    "context_root": "context/",
    "project_context": "context/project-context.md",
    "architecture_context": "context/architecture-context.md",
    "current_status": "context/current-status.md",
    "current_task_source": "context/current-status.md",
    "roadmap": "context/roadmap.md",
    "knowledge_strategy": "context/knowledge-strategy.md",
    "knowledge_root": "docs/knowledge/",
    "technical_root": "docs/technical/",
    "learning_root": "docs/learning/",
    "decision_root": "docs/adr/",
    "asset_index": "docs/technical/元数据/assets.yaml",
    "relation_index": "docs/technical/元数据/relations.yaml"
  },
  "layers": {
    "context": {
      "root": "context/",
      "role": "agent_runtime_context",
      "dynamic": true,
      "projection_eligible": false
    },
    "knowledge": {
      "root": "docs/knowledge/",
      "role": "human_knowledge",
      "dynamic": false,
      "projection_eligible": true
    },
    "technical": {
      "root": "docs/technical/",
      "role": "engineering_documentation",
      "dynamic": false,
      "projection_eligible": false
    },
    "learning": {
      "root": "docs/learning/",
      "role": "learning_assets",
      "dynamic": false,
      "projection_eligible": false
    },
    "decision": {
      "root": "docs/adr/",
      "role": "architecture_decisions",
      "dynamic": false,
      "projection_eligible": false
    }
  },
  "projection": {
    "source_root": "docs/knowledge/",
    "target_provider": "feishu",
    "target_role": "human_readable_projection",
    "direction": "git_to_feishu",
    "mode": "overwrite",
    "structure": "one_to_one",
    "publish_requires_reviewed_git": true,
    "publish_requires_confirmation": true,
    "reverse_write_allowed": false
  },
  "policies": {
    "default_identity": "user",
    "default_read_budget_chars": 12000,
    "max_full_documents": 3,
    "max_candidates": 8,
    "write_default": "dry-run",
    "git_review_required": true,
    "forbidden_automatic_operations": [
      "delete",
      "move",
      "permission_change",
      "member_change",
      "internet_publish",
      "force_push",
      "feishu_to_git_write"
    ]
  }
}
