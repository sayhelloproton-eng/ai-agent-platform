{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KnowledgeItem",
  "description": "A canonical human-readable Knowledge asset stored under docs/knowledge/.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asset_id",
    "title",
    "category",
    "source_path",
    "content",
    "metadata"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "source_path": {
      "type": "string",
      "pattern": "^docs/knowledge/"
    },
    "content": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "reviewed",
            "accepted",
            "deprecated",
            "archived"
          ]
        },
        "summary": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visibility": {
          "enum": [
            "public",
            "internal",
            "private"
          ]
        },
        "sensitivity": {
          "enum": [
            "none",
            "low",
            "high"
          ]
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "status"
      ],
      "properties": {
        "target": {
          "const": "feishu"
        },
        "status": {
          "enum": [
            "not_published",
            "pending",
            "published",
            "failed"
          ]
        },
        "source_revision": {
          "type": "string"
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
