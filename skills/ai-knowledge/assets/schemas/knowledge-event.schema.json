{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KnowledgeEvent",
  "description": "An evidenced change or publication event for a canonical Git asset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "project",
    "occurred_at",
    "asset",
    "summary",
    "evidence"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "enum": [
        "create",
        "update",
        "publish_projection",
        "export"
      ]
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "source_path"
      ],
      "properties": {
        "asset_id": {
          "type": "string"
        },
        "layer": {
          "enum": [
            "context",
            "knowledge",
            "technical",
            "learning",
            "decision"
          ]
        },
        "source_path": {
          "type": "string",
          "pattern": "^(context|docs/knowledge|docs/technical|docs/learning|docs/adr)/"
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "source_path"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "source_path": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          }
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "direction"
      ],
      "properties": {
        "target": {
          "const": "feishu"
        },
        "direction": {
          "const": "git_to_feishu"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "publish_projection"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "required": [
          "projection"
        ],
        "properties": {
          "asset": {
            "properties": {
              "layer": {
                "const": "knowledge"
              },
              "source_path": {
                "pattern": "^docs/knowledge/"
              }
            }
          }
        }
      }
    }
  ]
}
