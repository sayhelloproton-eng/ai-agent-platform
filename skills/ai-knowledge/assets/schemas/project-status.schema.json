{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectStatus",
  "type": "object",
  "required": [
    "project",
    "phase",
    "objective",
    "completed",
    "in_progress",
    "next",
    "blockers",
    "evidence",
    "updated_at"
  ],
  "properties": {
    "project": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "completed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item",
          "evidence_ids"
        ],
        "properties": {
          "item": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "in_progress": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "updated_at": {
      "type": "string"
    },
    "updated_by": {
      "type": "string"
    }
  }
}
