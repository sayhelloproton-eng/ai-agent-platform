{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextPackage",
  "description": "A task-scoped Agent Runtime Context package assembled from canonical Git assets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_role",
    "context_root",
    "task",
    "project_context",
    "current_status",
    "current_task",
    "architecture_constraints",
    "selected_sources",
    "facts",
    "gaps"
  ],
  "properties": {
    "package_role": {
      "const": "agent_runtime_context"
    },
    "context_root": {
      "const": "context/"
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "string"
    },
    "project_context": {
      "$ref": "#/$defs/contextSection"
    },
    "current_status": {
      "$ref": "#/$defs/contextSection"
    },
    "current_task": {
      "$ref": "#/$defs/contextSection"
    },
    "architecture_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "source_path"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "source_path": {
            "type": "string",
            "pattern": "^context/"
          }
        }
      }
    },
    "selected_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "source_path",
          "layer"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "source_path": {
            "type": "string",
            "pattern": "^(context|docs/knowledge|docs/technical|docs/learning|docs/adr|skills)/"
          },
          "layer": {
            "enum": [
              "context",
              "knowledge",
              "technical",
              "learning",
              "decision",
              "skill"
            ]
          },
          "reason": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "confidence",
          "source_paths"
        ],
        "properties": {
          "statement": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "confirmed",
              "inferred",
              "unknown"
            ]
          },
          "source_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "decisions": {
      "type": "array"
    },
    "gaps": {
      "type": "array"
    },
    "token_budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_chars": {
          "type": "integer",
          "minimum": 0
        },
        "used_chars": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "contextSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "source_path"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "source_path": {
          "type": "string",
          "pattern": "^context/"
        }
      }
    }
  }
}
