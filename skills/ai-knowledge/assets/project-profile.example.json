{
  "schema_version": "3.0",
  "project": {
    "id": "your-project",
    "display_name": "Your Project",
    "canonical_source": "git"
  },
  "canonical_entries": {
    "context_root": "context/",
    "current_status": "context/current-status.md",
    "current_task_source": "context/current-status.md",
    "knowledge_root": "docs/knowledge/",
    "technical_root": "docs/technical/",
    "learning_root": "docs/learning/",
    "decision_root": "docs/adr/"
  },
  "layers": {
    "context": {
      "root": "context/",
      "role": "agent_runtime_context",
      "dynamic": true,
      "projection_eligible": false
    },
    "knowledge": {
      "root": "docs/knowledge/",
      "role": "human_knowledge",
      "dynamic": false,
      "projection_eligible": true
    },
    "technical": {
      "root": "docs/technical/",
      "role": "engineering_documentation",
      "dynamic": false,
      "projection_eligible": false
    },
    "learning": {
      "root": "docs/learning/",
      "role": "learning_assets",
      "dynamic": false,
      "projection_eligible": false
    },
    "decision": {
      "root": "docs/adr/",
      "role": "architecture_decisions",
      "dynamic": false,
      "projection_eligible": false
    }
  },
  "projection": {
    "source_root": "docs/knowledge/",
    "target_provider": "feishu",
    "target_role": "human_readable_projection",
    "direction": "git_to_feishu",
    "mode": "overwrite",
    "structure": "one_to_one",
    "publish_requires_reviewed_git": true,
    "publish_requires_confirmation": true,
    "reverse_write_allowed": false
  },
  "policies": {
    "write_default": "dry-run",
    "git_review_required": true
  }
}
